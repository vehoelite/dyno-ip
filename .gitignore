# ── Client-Only Publishing Mode ──
# Keep this repository focused on Android/Windows/Linux clients only.
# Everything else is ignored at the root level.
/*
!/.gitignore
!/README.md
!/android/
!/android/**
!/clients/
!/clients/**

# Re-ignore generated artifacts within allowed client folders
clients/windows/dist/
clients/windows/build/
clients/windows/*.spec
clients/windows/__pycache__/
clients/pypi/src/dynoip.egg-info/
clients/pypi/src/dynoip/__pycache__/
clients/linux/*.deb
