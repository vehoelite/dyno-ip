[Unit]
Description=Dyno-IP Dynamic DNS Updater
Documentation=https://dyno-ip.com/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/dynoip-update
User=dynoip
Group=dynoip
EnvironmentFile=-/etc/default/dynoip

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/dynoip
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
